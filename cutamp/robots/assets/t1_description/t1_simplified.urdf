<?xml version="1.0" encoding="utf-8"?>
<!--
  Booster T1 Humanoid Robot - Simplified URDF for cuTAMP planning.

  Body chain (above the cuRobo planar base):
    mobile_base_link  (the wheeled platform, abstracted)
      ├─ ankle_pitch   (revolute Y)
      ├─ shank_link    (0.28 m cylinder)
      ├─ knee_pitch    (revolute Y)
      ├─ thigh_link    (0.28 m cylinder)
      ├─ Torso_Pitch   (revolute Y)
      └─ Trunk         (mesh, carries head + arms)

  ankle_pitch / knee_pitch limits are taken directly from the actual T1
  (actual_robot.urdf: Left_Ankle_Pitch and Left_Knee_Pitch). The shank
  length matches actual_robot.urdf as well; the thigh length is mirrored
  (this single-leg simplification skips the multi-segment hip chain on
  the real robot — Hip_Pitch + Hip_Roll + Hip_Yaw are intentionally
  omitted because the planar mobile base already provides yaw and the
  envs we plan in don't need lateral hip tilt).
-->
<robot name="booster_t1_torso">

  <!-- ==================== WORLD ANCHOR ==================== -->
  <!-- Static world frame. cuRobo's planar-base extra_links chain (base_j_x,
       base_j_y, base_j_yaw) re-parents mobile_base_link below this anchor,
       so the whole robot translates/rotates on the floor as a planning DOF. -->
  <link name="world"/>
  <joint name="world_to_mobile_base" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="mobile_base_link"/>
  </joint>

  <!-- ==================== MOBILE BASE PLATFORM ==================== -->
  <!-- The wheeled base (wheels themselves are abstracted by the planar joints).
       0.25 x 0.25 x 0.05 box; same dimensions as the prior lifting_base_link. -->
  <link name="mobile_base_link">
    <inertial>
      <origin xyz="0 0 0.021" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.021" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.25 0.042"/>
      </geometry>
      <material name="DarkGrey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.021" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.25 0.042"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== ANKLE PITCH (revolute) ==================== -->
  <!-- Mounted at the top of the mobile base (z = 0.05). Limits from
       actual_robot.urdf:1318-1319 (Left_Ankle_Pitch).

       The axis is "0 -1 0" (negated from the real URDF's "0 1 0") because
       this chain is inverted relative to the real robot: the leg here
       extends UP from the mobile base, while the real T1's leg extends
       DOWN from the body. Negating the Y axis keeps the SIGN of every
       joint value consistent with the real robot — positive ankle_pitch
       still corresponds to dorsiflexion (body tilts backward) in both
       URDFs, so any joint vector transferred between sim and hardware
       produces the same physical motion. -->
  <joint name="ankle_pitch" type="revolute">
    <origin xyz="0 0 0.042" rpy="0 0 0"/>
    <parent link="mobile_base_link"/>
    <child  link="shank_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.87" upper="0" effort="12" velocity="18.8"/>
  </joint>

  <!-- ==================== SHANK (0.28 m cylinder) ==================== -->
  <link name="shank_link">
    <inertial>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.01441" ixy="0.0" ixz="0.0"
               iyy="0.01441" iyz="0.0" izz="0.0025"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.28"/>
      </geometry>
      <material name="Silver">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.28"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== KNEE PITCH (revolute) ==================== -->
  <!-- At the top of the shank. Limits from actual_robot.urdf:1260-1261
       (Left_Knee_Pitch). Axis negated (see ankle_pitch above for the
       inverted-chain rationale). -->
  <joint name="knee_pitch" type="revolute">
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
    <parent link="shank_link"/>
    <child  link="thigh_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.34" effort="60" velocity="11.7"/>
  </joint>

  <!-- ==================== THIGH (0.236 m cylinder) ==================== -->
  <!-- Length 0.236m absorbs the real robot's Hip_Pitch → Hip_Roll → Hip_Yaw
       → Knee_Pitch chain (0.02 + 0.0819 + 0.134 = 0.236m) so the Trunk's
       world-Z at home matches actual_robot.urdf (0.6735m). -->
  <link name="thigh_link">
    <inertial>
      <origin xyz="0 0 0.118" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.01441" ixy="0.0" ixz="0.0"
               iyy="0.01441" iyz="0.0" izz="0.0025"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.118" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.236"/>
      </geometry>
      <material name="Grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.118" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.236"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== TORSO PITCH (revolute) ==================== -->
  <!-- At the top of the thigh. Coordinated abstraction of the real T1's
       Left_Hip_Pitch + Right_Hip_Pitch; limits taken from Left_Hip_Pitch.
       Axis negated (see ankle_pitch above for the inverted-chain rationale).

       The +0.014 X in the origin restores the real robot's knee setback:
       t1.urdf's Left_Knee_Pitch sits 0.014 m behind the hip (origin
       x=-0.014), which propagates down to the ankle. Because this chain is
       built ground-up, the joint that shifts the whole lower leg (thigh +
       shank + ankle) backward relative to the Trunk is THIS one (the upper
       boundary of the abstracted thigh), not knee_pitch — moving knee_pitch
       would only shift the ankle. With +0.014 here, the sim's hip/knee/ankle
       pitch-axis positions and segment lengths coincide with t1.urdf's, so
       broadcasting the leg joints reproduces the real Trunk pose to
       <0.15 mm / 0.000 deg across the whole leg workspace (verified
       2026-06-13). Fixes the prior 14 mm (home) -> ~24 mm (deep-lean)
       sim-to-real Trunk/hand offset. -->
  <joint name="Torso_Pitch" type="revolute">
    <origin xyz="0.014 0 0.236" rpy="0 0 0"/>
    <parent link="thigh_link"/>
    <child  link="Waist"/>
    <axis xyz="0 -1 0"/>
    <!-- velocity=12.5 matches real T1 Left/Right_Hip_Pitch (this joint
         abstracts both). Previously 50 was a placeholder.
         lower tightened -1.8 -> -1.7 (experiment 2026-06-11). -->
    <limit lower="-1.7" upper="0" effort="100" velocity="12.5"/>
  </joint>

  <!-- ==================== WAIST ==================== -->
  <!-- Hip mounting block between Torso_Pitch and Waist_Yaw. -->
  <link name="Waist">
    <inertial>
      <origin xyz="0.002284 0.000003 0.007301" rpy="0 0 0" />
      <mass value="2.581" />
      <inertia ixx="0.005289" ixy="0.000000" ixz="0.000207"
               iyy="0.005299" iyz="0.000001" izz="0.004821" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/Waist.STL" />
      </geometry>
      <material name="">
        <color rgba="0.4 0.4 0.4 0.3" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/Waist.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== WAIST YAW (revolute) ==================== -->
  <!-- Torso yaw between Waist and Trunk. Axis matches the real T1's Waist
       joint (actual_robot.urdf, axis="0 0 1"); Z-axis sign convention is the
       same in both URDFs (no flip needed for yaw). Limits tightened
       2026-06-11 to [-1.47, 1.47] from the real [-1.57, 1.57] (0.1 rad
       safety inset each side). -->
  <joint name="Waist_Yaw" type="revolute">
    <!-- This joint is reversed vs t1.urdf (here parent=Waist, child=Trunk)
         because our root is `world` and the chain reads bottom-up. Despite
         the reversal, the resulting Trunk LINK FRAME COINCIDES with the
         on-robot model t1.urdf's Trunk frame: FK of every Trunk child
         (head, shoulders, hands) matches t1.urdf to 0.0 m. So the saved
         plan's Trunk pose needs NO consumer-side X compensation — it is the
         t1.urdf Trunk pose directly. (An older reference, actual_robot.urdf,
         placed its Trunk frame 6.25 cm behind this one; that file is not what
         the MPC uses and is obsolete.) -->
    <origin xyz="0 0 0.1155" rpy="0 0 0" />
    <parent link="Waist" />
    <child link="Trunk" />
    <axis xyz="0 0 1" />
    <limit lower="-1.47" upper="1.47" effort="30" velocity="10.88" />
  </joint>

  <!-- ==================== TRUNK ==================== -->
  <!-- The visual/collision mesh origin carries a -0.0625 X offset: this is
       the Trunk.STL origin convention, IDENTICAL to t1.urdf (whose Trunk
       visual is also -0.0625 X), so the rendered geometry matches the MPC
       model exactly.
       The inertial origin (X = -0.06986) is INTENTIONALLY left as-inherited;
       do NOT "correct" it. When building this simplified model only the
       kinematic axes were changed (for the inverted leg chain) — the
       mass/inertia model is preserved deliberately because it ties into the
       MPC walking/tracking dynamics. It therefore differs from t1.urdf's
       Trunk inertial (-0.00736 X) by design; that difference feeds cuRobo's
       planning-side compute_com (CoM-over-base cost / CoM-aware IK) only, and
       does NOT affect the saved Trunk POSE (the kinematic frame is correct,
       per the Waist_Yaw note above). -->
  <link name="Trunk">
    <inertial>
      <origin xyz="-0.0698634598906924 -1.42058017623659E-06 0.105062332707657" rpy="0 0 0" />
      <mass value="11.7" />
      <inertia ixx="0.0915287235057927" ixy="-4.25369739206781E-07" ixz="0.000646360369011163"
               iyy="0.076778716903413" iyz="5.82340020271393E-07" izz="0.0556171053368987" />
    </inertial>
    <visual>
      <origin xyz="-0.0625 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/Trunk.STL" />
      </geometry>
      <material name="">
        <color rgba="0.76 0.76 0.76 0.2" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.0625 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/Trunk.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== HEAD ==================== -->
  <link name="H1">
    <inertial>
      <origin xyz="-0.000508 -0.001403 0.057432" rpy="0 0 0" />
      <mass value="0.443910" />
      <inertia ixx="0.000224" ixy="0.000003" ixz="0.000001"
               iyy="0.000241" iyz="-0.000002" izz="0.000150" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/H1.STL" />
      </geometry>
      <material name="">
        <color rgba="0.4 0.4 0.4 0.3" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/H1.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="AAHead_yaw" type="revolute">
    <!-- x=0 in our sim (vs +0.0625 in real). Paired with the Trunk frame
         being 6.25 cm forward of real's, this places H1 at the same world
         position the real robot produces. -->
    <origin xyz="0 0 0.243" rpy="0 0 0" />
    <parent link="Trunk" />
    <child link="H1" />
    <axis xyz="0 0 1" />
    <limit lower="-1.02" upper="1.02" effort="7" velocity="12.56" />
  </joint>

  <link name="H2">
    <inertial>
      <origin xyz="0.007802 0.001262 0.098631" rpy="0 0 0" />
      <mass value="0.631019" />
      <inertia ixx="0.002025" ixy="-0.000025" ixz="0.000046"
               iyy="0.001920" iyz="0.000036" izz="0.001739" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/H2.STL" />
      </geometry>
      <material name="">
        <color rgba="0.4 0.4 0.4 0.3" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/H2.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="Head_pitch" type="revolute">
    <origin xyz="0 0 0.06185" rpy="0 0 0" />
    <parent link="H1" />
    <child link="H2" />
    <axis xyz="0 1 0" />
    <limit lower="-0.514" upper="0.85" effort="7" velocity="12.56" />
  </joint>

  <!-- ==================== LEFT ARM ==================== -->
  <link name="AL1">
    <inertial>
      <origin xyz="-0.000677 0.044974 0.000000" rpy="0 0 0" />
      <mass value="0.53" />
      <inertia ixx="0.001293" ixy="-0.000017" ixz="0.000000"
               iyy="0.000293" iyz="0.000000" izz="0.001367" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL1.STL" />
      </geometry>
      <material name="">
        <color rgba="0.76 0.76 0.76 0.2" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL1.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="Left_Shoulder_Pitch" type="revolute">
    <!-- x=-0.005 in our sim (vs +0.0575 in real). Paired with the Trunk
         frame being 6.25 cm forward of real's, places AL1 at the same
         world position the real robot produces. -->
    <origin xyz="-0.005 0.1063 0.219" rpy="0 0.00088113 0" />
    <parent link="Trunk" />
    <child link="AL1" />
    <axis xyz="0 1 0" />
    <limit lower="-3.29" upper="1.18" effort="18" velocity="18.84" />
  </joint>

  <link name="AL2">
    <inertial>
      <origin xyz="0.003862 0.037976 0.000000" rpy="0 0 0" />
      <mass value="0.160" />
      <inertia ixx="0.000345" ixy="0.000008" ixz="0.000000"
               iyy="0.000177" iyz="0.000000" izz="0.000401" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL2.STL" />
      </geometry>
      <material name="">
        <color rgba="0.4 0.4 0.4 0.3" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL2.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="Left_Shoulder_Roll" type="revolute">
    <origin xyz="0 0.047 0" rpy="0 0 0" />
    <parent link="AL1" />
    <child link="AL2" />
    <axis xyz="1 0 0" />
    <limit lower="-1.577" upper="1.7055" effort="18" velocity="18.84" />
  </joint>

  <link name="AL3">
    <inertial>
      <origin xyz="0.000000 0.085353 -0.000099" rpy="0 0 0" />
      <mass value="1.02" />
      <inertia ixx="0.012869" ixy="0.000000" ixz="0.000000"
               iyy="0.000621" iyz="-0.000024" izz="0.012798" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL3.STL" />
      </geometry>
      <material name="">
        <color rgba="0.4 0.4 0.4 0.3" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL3.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="Left_Elbow_Pitch" type="revolute">
    <origin xyz="0.00025 0.0605 0" rpy="0 0 0" />
    <parent link="AL2" />
    <child link="AL3" />
    <axis xyz="0 1 0" />
    <limit lower="-2.234" upper="2.234" effort="100" velocity="18.84" />
  </joint>

  <link name="AL4">
    <inertial>
      <origin xyz="-0.00046851 0.062372 0.0015178" rpy="0 0 0" />
      <mass value="0.2984" />
      <inertia ixx="0.001673" ixy="-1.2E-05" ixz="0"
               iyy="0.000214" iyz="4E-06" izz="0.001608" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL4.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL4.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="Left_Elbow_Yaw" type="revolute">
    <origin xyz="0 0.1471 0" rpy="0 0 0" />
    <parent link="AL3" />
    <child link="AL4" />
    <axis xyz="0 0 1" />
    <limit lower="-2.1402" upper="1.6844" effort="18" velocity="18.84" />
  </joint>

  <link name="AL5">
    <inertial>
      <origin xyz="-3.8402E-05 0.036076 0.0056711" rpy="0 0 0" />
      <mass value="0.42219" />
      <inertia ixx="0.000823" ixy="0" ixz="0"
               iyy="0.000216" iyz="9.8E-05" izz="0.000785" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL5.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL5.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="Left_Wrist_Pitch" type="revolute">
    <origin xyz="0 0.105 0.00025" rpy="0 0 0" />
    <parent link="AL4" />
    <child link="AL5" />
    <axis xyz="0 1 0" />
    <limit lower="-2.5821" upper="2.5821" effort="7" velocity="12.56" />
  </joint>

  <link name="AL6">
    <inertial>
      <origin xyz="-0.00072939 0.056578 -0.0056257" rpy="0 0 0" />
      <mass value="0.26532" />
      <inertia ixx="0.001171" ixy="-1.5E-05" ixz="-1E-06"
               iyy="0.000166" iyz="-1.5E-05" izz="0.001138" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL6.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/AL6.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="Left_Wrist_Yaw" type="revolute">
    <origin xyz="0 0.042 0" rpy="0 0 0" />
    <parent link="AL5" />
    <child link="AL6" />
    <axis xyz="0 0 1" />
    <limit lower="-1.8185" upper="1.4261" effort="18" velocity="18.84" />
  </joint>

  <!-- left_hand_link: visual removed - AL7.STL contained old gripper geometry that's now in separate gripper links -->
  <link name="left_hand_link">
    <inertial>
      <origin xyz="-0.0067917 0.06373 0.011867" rpy="0 0 0" />
      <mass value="0.24875" />
      <inertia ixx="0.001568" ixy="-9.4E-05" ixz="-1.9E-05"
               iyy="0.000259" iyz="0.000214" izz="0.001609" />
    </inertial>
  </link>
  <joint name="Left_Hand_Roll" type="revolute">
    <origin xyz="0.00475 0.07 0.0015" rpy="0 0 0" />
    <parent link="AL6" />
    <child link="left_hand_link" />
    <axis xyz="1 0 0" />
    <limit lower="-1.3614" upper="1.4285" effort="7" velocity="12.56" />
  </joint>

  <!-- ==================== LEFT GRIPPER (4-BAR PARALLEL LINKAGE) ==================== -->
  <!--
    The gripper mechanism is a 4-bar parallel linkage with 4 joints (1 effective DOF).
    
    Structure:
      left_base_link (palm)
        └─ left_Link1 (finger 1 base) ─ left_Link11 (finger 1 tip)
        └─ left_Link2 (finger 2 base) ─ left_Link22 (finger 2 tip)
    
    Joint Rotation Axis:
      All 4 gripper joints rotate around the local Z-axis (axis xyz="0 0 1").
      This allows the fingers to close inward/outward for grasping.
    
    Linkage Relationship:
      For parallel finger motion (tips stay parallel to palm):
        Link11_angle = -Link1_angle
        Link22_angle = -Link2_angle
      
    Gripper States:
      Closed: All joints at 0.0
      Open:   Pattern like (θ, -θ, -θ, θ) for θ > 0
    
    Note: The fixed 90-degree yaw rotation (rpy="0 0 1.5708") on the left_base_link
    joint orients the gripper correctly relative to the hand_link.
  -->
  <link name="left_base_link">
    <inertial>
      <origin xyz="0.00339303654278191 -2.1205433560656E-05 -0.0099185365078758" rpy="0 0 0" />
      <mass value="0.105853592307918" />
      <inertia ixx="3.93795927851199E-05" ixy="-8.7395226509728E-08" ixz="5.91928672040786E-07"
               iyy="0.000106376720416166" iyz="-1.82858764303774E-10" izz="0.000125852616063213" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
